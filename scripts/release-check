#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)
OUTPUT=${1:-"$ROOT/.tools/release"}
mkdir -p "$OUTPUT"

EVENTGLASS_RELEASE_PLATFORM=linux/amd64 \
    "$SCRIPT_DIR/build-release" "$OUTPUT/eventglass-linux-amd64"
EVENTGLASS_RELEASE_PLATFORM=linux/arm64 \
    "$SCRIPT_DIR/build-release" "$OUTPUT/eventglass-linux-arm64"
"$SCRIPT_DIR/release-metadata.py" "$OUTPUT"

case "$(file "$OUTPUT/eventglass-linux-amd64")" in
    *ELF*x86-64*) ;;
    *) printf 'release-check: invalid amd64 artifact\n' >&2; exit 1 ;;
esac
case "$(file "$OUTPUT/eventglass-linux-arm64")" in
    *ELF*ARM\ aarch64*) ;;
    *) printf 'release-check: invalid arm64 artifact\n' >&2; exit 1 ;;
esac
if command -v sha256sum >/dev/null 2>&1; then
    (cd "$OUTPUT" && sha256sum --check SHA256SUMS)
else
    (cd "$OUTPUT" && shasum -a 256 --check SHA256SUMS)
fi
printf 'release-check: amd64/arm64 binaries, SPDX, notices, and checksums passed\n'
