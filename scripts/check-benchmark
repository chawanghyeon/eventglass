#!/usr/bin/env python3
"""Run deterministic capacity and sustained profiles with verified Linux limits."""

import argparse
import hashlib
import json
import pathlib
import subprocess


ROOT = pathlib.Path(__file__).resolve().parents[1]
IMAGE = "rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97"
MEMORY_BYTES = 536_870_912
OPERATIONAL_MEMORY_BYTES = 1_073_741_824
OPERATIONAL_DISK_BUDGET_BYTES = 50_000_000_000
PROFILES = {"smoke": 10_000, "100k": 100_000, "1m": 1_000_000, "10m": 10_000_000, "sustained": 100_000}
SUSTAINED = {
    "warmup_seconds": 300,
    "sustained_seconds": 1_800,
    "drain_seconds": 600,
    "records_per_second": 105,
}


def run_container(arguments, stdout=None):
    identifier = subprocess.check_output(
        ["docker", "create", *arguments], text=True
    ).strip()
    print(f"Benchmark container: {identifier}", flush=True)
    try:
        result = subprocess.run(
            ["docker", "start", "--attach", identifier], stdout=stdout
        )
        state = json.loads(
            subprocess.check_output(
                ["docker", "inspect", "--format", "{{json .State}}", identifier],
                text=True,
            )
        )
        if result.returncode or state["ExitCode"] or state["OOMKilled"]:
            raise RuntimeError("Container failed: " + json.dumps(state))
        return state
    finally:
        subprocess.run(
            ["docker", "rm", "--force", identifier],
            check=True,
            stdout=subprocess.DEVNULL,
        )


def source_hash():
    digest = hashlib.sha256()
    roots = ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "build.rs"]
    paths = [ROOT / name for name in roots]
    for directory in ["src", "migrations", "tests"]:
        paths.extend(path for path in (ROOT / directory).rglob("*") if path.is_file())
    for path in sorted(paths):
        digest.update(str(path.relative_to(ROOT)).encode())
        digest.update(b"\0")
        digest.update(path.read_bytes())
    return digest.hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("profile", choices=PROFILES, nargs="?", default="100k")
    parser.add_argument(
        "--operational",
        action="store_true",
        help="measure under the production 0.25 CPU / 1 GiB / 50 GB data budget",
    )
    parser.add_argument("--report", type=pathlib.Path)
    args = parser.parse_args()
    records = PROFILES[args.profile]
    cpus = 0.25 if args.operational else 1
    memory_bytes = OPERATIONAL_MEMORY_BYTES if args.operational else MEMORY_BYTES
    suffix = "-operational" if args.operational else ""
    report = (args.report or ROOT / f".tools/benchmark/{args.profile}{suffix}.json").resolve()
    report.parent.mkdir(parents=True, exist_ok=True)
    report.unlink(missing_ok=True)
    subprocess.run(
        ["docker", "info", "--format", "{{.OSType}}/{{.Architecture}}"], check=True
    )
    revision = subprocess.check_output(
        ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True
    ).strip()
    target_volume = "eventglass-benchmark-target"
    cargo_volume = "eventglass-benchmark-cargo"
    mounts = [
        "--mount",
        f"type=bind,src={ROOT},dst=/workspace,readonly",
        "--mount",
        f"type=volume,src={target_volume},dst=/target",
        "--mount",
        f"type=volume,src={cargo_volume},dst=/cargo",
        "--workdir",
        "/workspace",
    ]
    try:
        print(
            "Build phase: 2 CPUs / 4 GiB. Benchmark phase: "
            f"{cpus} CPU / {memory_bytes} bytes / no swap / {records} records.",
            flush=True,
        )
        artifact_log = report.parent / f".{args.profile}-artifacts.jsonl"
        with artifact_log.open("w") as output:
            run_container(
                [
                    "--cpus=2",
                    "--memory=4294967296",
                    "--memory-swap=4294967296",
                    *mounts,
                    "-e",
                    "CARGO_HOME=/cargo",
                    "-e",
                    "CARGO_TARGET_DIR=/target",
                    "-e",
                    "CARGO_BUILD_JOBS=2",
                    IMAGE,
                    "cargo",
                    "test",
                    "--locked",
                    "--release",
                    "--test",
                    "benchmark",
                    "--no-run",
                    "--message-format=json",
                ],
                stdout=output,
            )
        executable = None
        executable_profile = {}
        for line in artifact_log.read_text().splitlines():
            item = json.loads(line)
            if (
                item.get("reason") == "compiler-artifact"
                and item.get("target", {}).get("name") == "benchmark"
                and item.get("executable")
            ):
                executable = item["executable"]
                executable_profile = item.get("profile", {})
        artifact_log.unlink()
        if executable is None:
            raise RuntimeError("benchmark test executable was not produced")
        if (
            executable_profile.get("opt_level") != "3"
            or executable_profile.get("debug_assertions") is not False
            or executable_profile.get("overflow_checks") is not False
        ):
            raise RuntimeError(
                "benchmark executable does not prove release optimization: "
                + json.dumps(executable_profile, sort_keys=True)
            )

        limited = [
            f"--cpus={cpus}",
            f"--memory={memory_bytes}",
            f"--memory-swap={memory_bytes}",
            "--network=none",
            *mounts,
        ]
        list_output = subprocess.check_output(
            [
                "docker",
                "run",
                "--rm",
                *limited,
                IMAGE,
                executable,
                "--ignored",
                "--exact",
                "seeded_dataset_capacity",
                "--list",
                "--format",
                "terse",
            ],
            text=True,
        )
        selected = sum(line.endswith(": test") for line in list_output.splitlines())
        if selected != 1:
            raise RuntimeError(f"benchmark selected {selected} tests instead of one")
        environment = [
            "-e",
            f"EVENTGLASS_BENCH_PROFILE={args.profile}",
            "-e",
            f"EVENTGLASS_BENCH_RECORDS={records}",
            "-e",
            f"EVENTGLASS_BENCH_REPORT=/report/{report.name}",
            "-e",
            f"EVENTGLASS_BENCH_REVISION={revision}",
            "-e",
            "EVENTGLASS_BENCH_RUST_VERSION=1.97.1",
        ]
        if args.operational:
            environment.extend(
                ["-e", f"EVENTGLASS_BENCH_DISK_BUDGET_BYTES={OPERATIONAL_DISK_BUDGET_BYTES}"]
            )
        if args.profile == "sustained":
            environment.extend(
                [
                    "-e",
                    f"EVENTGLASS_BENCH_WARMUP_SECONDS={SUSTAINED['warmup_seconds']}",
                    "-e",
                    f"EVENTGLASS_BENCH_SUSTAINED_SECONDS={SUSTAINED['sustained_seconds']}",
                    "-e",
                    f"EVENTGLASS_BENCH_DRAIN_SECONDS={SUSTAINED['drain_seconds']}",
                    "-e",
                    f"EVENTGLASS_BENCH_RECORDS_PER_SECOND={SUSTAINED['records_per_second']}",
                ]
            )
        state = run_container(
            [
                *limited,
                "--mount",
                f"type=bind,src={report.parent},dst=/report",
                *environment,
                IMAGE,
                executable,
                "--ignored",
                "--exact",
                "seeded_dataset_capacity",
                "--nocapture",
            ]
        )
        evidence = json.loads(report.read_text())
        cgroup = evidence["cgroup"]
        if cgroup["memory.max"] != str(memory_bytes):
            raise RuntimeError("memory.max does not prove the configured memory limit")
        if cgroup["memory.swap.max"] != "0":
            raise RuntimeError("memory.swap.max does not prove swap is disabled")
        quota, period = map(int, cgroup["cpu.max"].split())
        if quota != int(period * cpus):
            raise RuntimeError("cpu.max does not prove the configured CPU quota")
        memory_events = dict(
            line.split() for line in cgroup["memory.events"].splitlines()
        )
        if int(memory_events.get("oom", "0")) != 0:
            raise RuntimeError("benchmark cgroup recorded an OOM")
        if args.operational:
            if evidence["disk_budget_bytes"] != OPERATIONAL_DISK_BUDGET_BYTES:
                raise RuntimeError("operational data budget missing from evidence")
            if evidence["data_dir_bytes"] > OPERATIONAL_DISK_BUDGET_BYTES:
                raise RuntimeError("benchmark data exceeded the 50 GB operational budget")
        if args.profile == "sustained":
            expected_records = (
                SUSTAINED["sustained_seconds"] * SUSTAINED["records_per_second"]
            )
            for field, seconds in [
                ("warmup_duration_ms", SUSTAINED["warmup_seconds"]),
                ("sustained_duration_ms", SUSTAINED["sustained_seconds"]),
                ("drain_duration_ms", SUSTAINED["drain_seconds"]),
            ]:
                if evidence[field] < seconds * 1_000:
                    raise RuntimeError(f"{field} does not prove the required phase")
            if evidence["sustained_records"] != expected_records:
                raise RuntimeError("sustained phase did not accept the required records")
            if evidence["inbox_records_after_drain"] != 0:
                raise RuntimeError("sustained drain left Inbox records")
        evidence.update(
            {
                "image": IMAGE,
                "source_sha256": source_hash(),
                "runtime_limits": {
                    "cpus": cpus,
                    "memory_bytes": memory_bytes,
                    "swap_bytes": 0,
                    "data_budget_bytes": OPERATIONAL_DISK_BUDGET_BYTES if args.operational else None,
                },
                "container_oom_killed": state["OOMKilled"],
                "selected_tests": selected,
                "build_profile": {
                    "name": "release",
                    "opt_level": executable_profile.get("opt_level"),
                    "debug_assertions": executable_profile.get("debug_assertions"),
                    "overflow_checks": executable_profile.get("overflow_checks"),
                },
            }
        )
        replacement = report.with_suffix(report.suffix + ".tmp")
        replacement.write_text(json.dumps(evidence, indent=2) + "\n")
        replacement.replace(report)
        print(f"Benchmark evidence: {report}", flush=True)
        print(
            f"Passed: {records} records; peak: {cgroup['memory.peak']} bytes; "
            f"seed: {evidence['seed_records_per_second']:.1f} records/s",
            flush=True,
        )
    finally:
        artifact_log = report.parent / f".{args.profile}-artifacts.jsonl"
        artifact_log.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
