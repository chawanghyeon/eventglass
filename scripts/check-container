#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)
IMAGE=eventglass:release-smoke
NAME="eventglass-smoke-$$"
VOLUME="eventglass-smoke-$$"
: "${EVENTGLASS_CONTAINER_PLATFORM:=linux/arm64}"

cleanup() {
    docker rm -f "$NAME" >/dev/null 2>&1 || :
    docker volume rm "$VOLUME" >/dev/null 2>&1 || :
}
trap cleanup EXIT HUP INT TERM

docker buildx build --platform "$EVENTGLASS_CONTAINER_PLATFORM" --load --tag "$IMAGE" "$ROOT"
docker volume create "$VOLUME" >/dev/null

start() {
    docker run --detach --name "$NAME" \
        --read-only \
        --cap-drop ALL \
        --security-opt no-new-privileges \
        --memory 768m \
        --cpus 1 \
        --publish 127.0.0.1::8080 \
        --volume "$VOLUME:/data" \
        "$IMAGE" >/dev/null
}

ready() {
    port=$(docker port "$NAME" 8080/tcp | sed 's/.*://')
    attempt=0
    while [ "$attempt" -lt 100 ]; do
        if curl --fail --silent "http://127.0.0.1:$port/readyz" >/dev/null; then
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 0.1
    done
    docker logs "$NAME" >&2
    return 1
}

start
ready
[ "$(docker exec "$NAME" id -u)" = 10001 ]
docker stop --time 30 "$NAME" >/dev/null
docker rm "$NAME" >/dev/null
start
ready
docker exec "$NAME" eventglass doctor >/dev/null
docker stop --time 30 "$NAME" >/dev/null
printf 'container smoke: non-root, read-only root, one CPU, 768 MiB, persistent /data restart passed\n'
