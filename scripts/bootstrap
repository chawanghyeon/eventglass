#!/bin/sh
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
VERSION=1.26.5
INSTALL="$ROOT/.tools/go$VERSION"

if [ -x "$INSTALL/bin/go" ]; then
  actual=$("$INSTALL/bin/go" env GOVERSION | sed 's/^go//')
  if [ "$actual" = "$VERSION" ]; then
    echo "Go $VERSION is already installed at $INSTALL"
    exit 0
  fi
  echo "$INSTALL exists but contains Go $actual; remove that exact directory and retry" >&2
  exit 1
fi

case "$(uname -s)-$(uname -m)" in
  Darwin-x86_64)
    platform=darwin-amd64
    checksum=6231d8d3b8f5552ec6cbf6d685bdd5482e1e703214b120e89b3bf0d7bf1ef725
    ;;
  Darwin-arm64)
    platform=darwin-arm64
    checksum=efb87ff28af9a188d0536ef5d42e63dd52ba8263cd7344a993cc48dd11dedb6a
    ;;
  Linux-x86_64)
    platform=linux-amd64
    checksum=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
    ;;
  Linux-aarch64|Linux-arm64)
    platform=linux-arm64
    checksum=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49
    ;;
  *)
    echo "unsupported bootstrap platform: $(uname -s)-$(uname -m)" >&2
    exit 1
    ;;
esac

mkdir -p "$ROOT/.tools"
temporary=$(mktemp -d "$ROOT/.tools/go-bootstrap.XXXXXX")
cleanup() {
  rm -rf "$temporary"
}
trap cleanup EXIT INT TERM

archive="$temporary/go$VERSION.$platform.tar.gz"
curl -fsSLo "$archive" "https://go.dev/dl/go$VERSION.$platform.tar.gz"
if command -v sha256sum >/dev/null 2>&1; then
  echo "$checksum  $archive" | sha256sum -c -
else
  echo "$checksum  $archive" | shasum -a 256 -c -
fi
tar -xzf "$archive" -C "$temporary"
mv "$temporary/go" "$INSTALL"

echo "Installed Go $VERSION at $INSTALL"
