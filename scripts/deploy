#!/bin/sh
# Build and stage the exact local commit. GitHub activates it after the push.
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)
REVISION=$(git -C "$ROOT" rev-parse HEAD)
BINARY="$ROOT/.tools/release/eventglass-linux-arm64"

"$SCRIPT_DIR/build-release" "$BINARY"
case "$(file "$BINARY")" in
    *ELF*ARM\ aarch64*) ;;
    *) printf 'deploy: release is not a Linux AArch64 ELF binary\n' >&2; exit 1 ;;
esac
if command -v sha256sum >/dev/null 2>&1; then
    DIGEST=$(sha256sum "$BINARY" | awk '{print $1}')
else
    DIGEST=$(shasum -a 256 "$BINARY" | awk '{print $1}')
fi

{
    printf 'stage %s %s\n' "$REVISION" "$DIGEST"
    cat "$BINARY"
} | ssh -o BatchMode=yes -o ConnectTimeout=10 oracle \
    sudo -n /usr/local/sbin/eventglass-deploy-recv
printf 'deploy: staged %s; GitHub will activate it after push\n' "$REVISION"
