#!/usr/bin/env python3
"""Build Linux artifacts separately, then verify actual one-CPU memory-limited test execution."""
import argparse
import hashlib
import json
import pathlib
import shutil
import subprocess
import tempfile

ROOT = pathlib.Path(__file__).resolve().parents[1]
IMAGE = 'rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97'
TARGETS = ['contracts', 'integration', 'auth', 'ingest', 'ingest_http', 'sdk', 'indexer_native', 'indexer', 'indexer_db', 'issues', 'issue_detail', 'tokens', 'query_scope', 'search', 'search_http', 'live_http', 'records_http', 'seal', 'archive', 'aggregate']

def container(arguments, stdout=None):
    identifier = subprocess.check_output(['docker', 'create', *arguments], text=True).strip()
    print('Resource gate container: ' + identifier, flush=True)
    try:
        result = subprocess.run(['docker', 'start', '--attach', identifier], stdout=stdout)
        state = json.loads(subprocess.check_output(['docker', 'inspect', '--format', '{{json .State}}', identifier], text=True))
        if result.returncode or state['ExitCode'] or state['OOMKilled']:
            raise RuntimeError('Container failed: ' + json.dumps(state))
        return state
    finally:
        subprocess.run(['docker', 'rm', identifier], check=True, stdout=subprocess.DEVNULL)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--memory-bytes', type=int, default=1073741824, choices=[536870912, 1073741824])
    parser.add_argument('--report', type=pathlib.Path, default=ROOT / '.tools/resource/report.json')
    args = parser.parse_args()
    args.report = args.report.resolve()
    args.report.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(['docker', 'info', '--format', '{{.OSType}}/{{.Architecture}}'], check=True)
    with tempfile.TemporaryDirectory(prefix='eventglass-linux-tests-') as temporary:
        stage = pathlib.Path(temporary)
        for name in ['Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', 'build.rs']:
            shutil.copy2(ROOT/name, stage/name)
        for name in ['src', 'migrations', 'tests']:
            shutil.copytree(ROOT/name, stage/name)
        source_hash = hashlib.sha256()
        for path in sorted(stage.rglob('*')):
            if path.is_file():
                source_hash.update(str(path.relative_to(stage)).encode()+b'\0'+path.read_bytes())
        report_dir = stage/'report'
        report_dir.mkdir()
        shutil.copy2(ROOT/'tools/resource/run_tests.py', report_dir/'run_tests.py')
        mounts = ['--mount', f'type=bind,src={stage},dst=/workspace,readonly', '--mount', 'type=volume,src=eventglass-linux-test-target,dst=/target', '--workdir', '/workspace']
        cargo = ['cargo', 'test', '--locked', '--no-run', '--message-format=json', '--lib']
        for target in TARGETS:
            if not (stage/'tests'/f'{target}.rs').is_file():
                raise RuntimeError('Required target missing: '+target)
            cargo.extend(['--test', target])
        print('Build phase: 2 CPUs / 4 GiB. Product test phase below: 1 CPU / '+str(args.memory_bytes)+' bytes / no swap.', flush=True)
        with (stage/'artifacts.jsonl').open('w') as output:
            container(['--cpus=2', '--memory=4294967296', '--memory-swap=4294967296', *mounts, '--mount', 'type=volume,src=eventglass-linux-test-cargo,dst=/cargo', '-e', 'CARGO_HOME=/cargo', '-e', 'CARGO_TARGET_DIR=/target', '-e', 'CARGO_BUILD_JOBS=2', IMAGE, *cargo], stdout=output)
        artifacts = {}
        for line in (stage/'artifacts.jsonl').read_text().splitlines():
            item = json.loads(line)
            if item.get('reason') != 'compiler-artifact' or not item.get('executable') or not item.get('profile', {}).get('test'):
                continue
            target = item['target']
            name = 'lib' if target['kind'] == ['lib'] else target['name']
            if name in TARGETS or name == 'lib':
                artifacts[name] = {'name': name, 'executable': item['executable']}
        if set(artifacts) != set(TARGETS+['lib']):
            raise RuntimeError('Compiled test set differs from required test set: '+str(sorted(artifacts)))
        (report_dir/'artifacts.json').write_text(json.dumps([artifacts[name] for name in ['lib', *TARGETS]]))
        try:
            container(['--cpus=1', '--memory='+str(args.memory_bytes), '--memory-swap='+str(args.memory_bytes), '--network=none', *mounts, '--mount', f'type=bind,src={report_dir},dst=/report', IMAGE, 'python3', '/report/run_tests.py', str(args.memory_bytes)])
        finally:
            if (report_dir/'report.json').exists():
                report = json.loads((report_dir/'report.json').read_text())
                report.update({'image': IMAGE, 'source_sha256': source_hash.hexdigest(), 'build_limits': {'cpus': 2, 'memory_bytes': 4294967296}, 'excluded': ['embedded UI assets', 'failpoint crash suite', 'live SDK processes', '100K/1M/10M workload', 'S3 restore']})
                args.report.write_text(json.dumps(report, indent=2)+'\n')
                print('Resource evidence: '+str(args.report), flush=True)
                print('Passed: '+str(report['passed'])+'; tests: '+str(sum(item['selected'] for item in report['tests']))+'; peak bytes: '+str(report['memory_peak_bytes'])+'; OOM events: '+str(report['memory_events'].get('oom')), flush=True)

if __name__ == '__main__':
    main()
