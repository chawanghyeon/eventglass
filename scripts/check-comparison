#!/bin/sh
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
case "$(uname -m)" in
  arm64|aarch64) ;;
  *) echo "comparison verification supports ARM64 only" >&2; exit 1 ;;
esac
mode=${EVENTGLASS_COMPARISON_MODE:-sustained}
case "$mode" in sustained|capacity) ;; *) echo 'invalid comparison mode' >&2; exit 2 ;; esac

# Exercise reporting/provenance/error cleanup contracts before measuring load.
GOCACHE="$ROOT/.tools/go-build-cache" GOMODCACHE="$ROOT/.tools/go-mod-cache" \
  go test -tags comparison -count=1 \
  -skip '^(TestPrepareComparisonInstallation|TestSustainedComparison|TestPostLoadComparison|TestPrepareCapacityWorkload|TestMeasureCapacityDrain)$' \
  ./tests/comparison ./tests/comparison/report

revision=$(git rev-parse HEAD)
if [ -n "$(git status --porcelain)" ]; then
  revision="${revision}-dirty"
fi
reuse_images=${EVENTGLASS_COMPARISON_REUSE_IMAGES:-}
build_image=${EVENTGLASS_COMPARISON_BUILD_IMAGE:-eventglass-go:comparison-build}
runtime_image=${EVENTGLASS_COMPARISON_RUNTIME_IMAGE:-eventglass-go:comparison-runtime}
if [ -n "$reuse_images" ] && [ "$reuse_images" != "1" ]; then
  echo "EVENTGLASS_COMPARISON_REUSE_IMAGES must be 1 or unset" >&2
  exit 2
fi
if [ "$reuse_images" = "1" ]; then
  if [ "${EVENTGLASS_COMPARISON_QUICK:-}" != "1" ]; then
    echo "comparison image reuse is restricted to quick diagnostics" >&2
    exit 2
  fi
  docker image inspect "$build_image" "$runtime_image" >/dev/null
  revision=${EVENTGLASS_COMPARISON_REUSE_REVISION:-unverified-reused-image}
else
  if [ "$build_image" != "eventglass-go:comparison-build" ] || [ "$runtime_image" != "eventglass-go:comparison-runtime" ]; then
    echo "custom comparison images are restricted to quick reuse diagnostics" >&2
    exit 2
  fi
  ./scripts/build-image --target build --load --tag eventglass-go:comparison-build
  ./scripts/build-image --load --tag eventglass-go:comparison-runtime
fi
if [ "$mode" = sustained ] && [ "${EVENTGLASS_COMPARISON_QUICK:-}" != "1" ]; then
  # Mode A must exercise the actual engine, not only the selector checksums.
  EVENTGLASS_NATIVE_ORACLE_IMAGE="$build_image" ./scripts/check-native-oracle
fi
run_dir=$(mktemp -d "$ROOT/.tools/eventglass-comparison.XXXXXX")
active_project=""
app_containers=""
stats_pid=""
capacity_observer=""
capacity_pid=""
cleanup_profile() {
  if [ -n "$capacity_observer" ]; then docker rm -f "$capacity_observer" >/dev/null 2>&1 || true; fi
  if [ -n "$capacity_pid" ]; then wait "$capacity_pid" >/dev/null 2>&1 || true; fi
  if [ -n "$stats_pid" ]; then kill "$stats_pid" >/dev/null 2>&1 || true; wait "$stats_pid" >/dev/null 2>&1 || true; fi
  capacity_observer=""
  capacity_pid=""
  stats_pid=""
  for container in $app_containers; do docker rm -f "$container" >/dev/null 2>&1 || true; done
  if [ -n "$active_project" ]; then
    docker compose -p "$active_project" -f deploy/compose.yaml down --volumes --remove-orphans >/dev/null 2>&1 || true
  fi
  app_containers=""
  active_project=""
}
cleanup() {
  cleanup_profile
  rm -rf "$run_dir"
}
trap cleanup EXIT INT TERM

if [ "$mode" = capacity ]; then
  if [ "${EVENTGLASS_COMPARISON_QUICK:-}" = "1" ]; then
    profiles=${EVENTGLASS_COMPARISON_WORKERS:-"1 2 4"}
    capacity_cycles=32
  else
    profiles="1 2 4 1 2 4 1 2 4"
    capacity_cycles=128
  fi
  # Compile before starting any timed capacity phase, including the reporter.
  docker run --rm --platform linux/arm64 --network none -v "$run_dir:/comparison" \
    -v "$ROOT/tests/comparison:/src/tests/comparison:ro" -w /src "$build_image" \
    go test -tags comparison -c -o /comparison/capacity.test ./tests/comparison
  go build -o "$run_dir/capacity-report" ./tests/comparison/report
  {
    printf 'revision=%s\n' "$revision"
    docker image inspect --format '{{.Id}} {{.Architecture}}' "$build_image" "$runtime_image"
    docker info --format 'host_arch={{.Architecture}} host_cpus={{.NCPU}} host_memory={{.MemTotal}}'
    shasum -a 256 "$run_dir/capacity.test" tests/comparison/capacity_test.go scripts/comparison-capacity
    docker run --rm --platform linux/arm64 --network none "$build_image" \
      sha256sum /out/eventglass-go /opt/duckdb/lib/libduckdb_bundle.a
    printf '%s\n' 'role_cpu=1 role_memory=512MiB swap=0 scratch=tmpfs isolated_PG_S3=tmpfs preload_concurrency=1 projects=4 native_dependencies=pinned'
  } >"$run_dir/capacity-environment.txt"
elif [ "${EVENTGLASS_COMPARISON_QUICK:-}" = "1" ]; then
  profiles="${EVENTGLASS_COMPARISON_WORKERS:-1}"
  warmup=${EVENTGLASS_COMPARISON_WARMUP:-20s}
  load=${EVENTGLASS_COMPARISON_LOAD:-60s}
  drain=${EVENTGLASS_COMPARISON_DRAIN:-30s}
  test_timeout=30m
else
  profiles=${EVENTGLASS_COMPARISON_WORKERS:-"1 2 4"}
  warmup=5m
  load=30m
  drain=10m
  test_timeout=1h
fi
input_epoch=""
if [ "$mode" = sustained ]; then
  input_epoch=${EVENTGLASS_COMPARISON_INPUT_EPOCH:-$(date -u +%s)}
  case "$input_epoch" in
    ''|*[!0-9]*) echo 'EVENTGLASS_COMPARISON_INPUT_EPOCH must be a positive Unix timestamp' >&2; exit 2 ;;
  esac
  if [ "$input_epoch" -eq 0 ]; then echo 'EVENTGLASS_COMPARISON_INPUT_EPOCH must be a positive Unix timestamp' >&2; exit 2; fi
fi

comparison_binary="$run_dir/capacity.test"
if [ "$mode" = sustained ]; then
  comparison_binary="$run_dir/comparison.test"
  # Compilation must not compete with startup maintenance or measured load.
  # Reuse this exact test executable for prepare, sustained and cold/idle phases.
  docker run --rm --platform linux/arm64 --network none -v "$run_dir:/comparison" \
    -v "$ROOT/tests/comparison:/src/tests/comparison:ro" -w /src "$build_image" \
    go test -tags comparison -c -o /comparison/comparison.test ./tests/comparison
fi

start_runtime() {
  name=$1
  role=$2
  prefix=$3
  docker run -d --name "$name" --platform linux/arm64 --network "${active_project}_default" \
    --cpus 1 --memory 512m --memory-swap 512m --pids-limit 256 --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,size=4g -v "$secrets_dir:/run/eventglass:ro" \
    -e EVENTGLASS_DATABASE_URL="$database_url" \
    -e EVENTGLASS_PUBLIC_URL="$public_url" \
    -e EVENTGLASS_ROLES="$role" \
    -e EVENTGLASS_HTTP_ADDR=:8080 \
    -e EVENTGLASS_METRICS_ADDR=:9090 \
    -e EVENTGLASS_SCRATCH_DIR=/tmp/eventglass \
    -e EVENTGLASS_S3_ENDPOINT=http://minio:9000 \
    -e EVENTGLASS_S3_REGION=us-east-1 \
    -e EVENTGLASS_S3_BUCKET=eventglass-g00 \
    -e EVENTGLASS_S3_PREFIX="$prefix" \
    -e AWS_ACCESS_KEY_ID=eventglass-local \
    -e AWS_SECRET_ACCESS_KEY=eventglass-local-secret \
    -e EVENTGLASS_ALERT_ENCRYPTION_KEY_FILE=/run/eventglass/alert.hex \
    "$runtime_image" run >/dev/null
}

capture_cgroup() {
  observed_container=$1
  observed_id=$(docker inspect --format '{{.Id}}' "$observed_container") || return 1
  docker exec "$observed_container" sh -c '
    peak=$(cat /sys/fs/cgroup/memory.peak) || exit 1
    limit=$(cat /sys/fs/cgroup/memory.max) || exit 1
    swap=$(cat /sys/fs/cgroup/memory.swap.max) || exit 1
    oom=missing
    killed=missing
    while read -r key value; do
      case "$key" in oom) oom=$value ;; oom_kill) killed=$value ;; esac
    done </sys/fs/cgroup/memory.events
    printf "%s %s %s %s %s %s %s\n" "$1" "$2" "$peak" "$oom" "$killed" "$limit" "$swap"
  ' sh "$observed_container" "$observed_id" >>"$cgroup_file"
}

profile_index=0
profile_failures=0
for workers in $profiles; do
  case "$workers" in 1|2|4) ;; *) echo 'workers must be 1,2,4' >&2; exit 2 ;; esac
  profile_index=$((profile_index + 1))
  if [ "$profile_index" -gt 9 ]; then echo 'at most nine comparison profiles are allowed' >&2; exit 2; fi
  active_project="eventglass-go-comparison-${workers}-$$"
  profile_dir="$run_dir/workers-$workers-$profile_index"
  secrets_dir="$profile_dir/secrets"
  artifacts_dir="$profile_dir/artifacts"
  mkdir -p "$secrets_dir" "$artifacts_dir"
  for name in bootstrap auth token alert; do
    openssl rand -hex 32 >"$secrets_dir/$name.hex"
    chmod 600 "$secrets_dir/$name.hex"
  done
  bootstrap_token=$(tr -d '\n' <"$secrets_dir/bootstrap.hex")
  database_url="postgres://eventglass:local-test-only@postgres:5432/eventglass?sslmode=disable" # pragma: allowlist secret -- disposable fixture
  public_url=https://eventglass.invalid
  prefix="comparison-$workers"

  docker compose -p "$active_project" -f deploy/compose.yaml up -d postgres minio
  docker compose -p "$active_project" -f deploy/compose.yaml run --rm minio-init
  attempt=0
  until docker compose -p "$active_project" -f deploy/compose.yaml exec -T postgres pg_isready -U eventglass -d eventglass >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 60 ]; then echo "comparison PostgreSQL did not become ready" >&2; exit 1; fi
    sleep 1
  done
  migration_attempt=0
  until docker run --rm --platform linux/arm64 --network "${active_project}_default" \
    -e EVENTGLASS_DATABASE_URL="$database_url" "$runtime_image" migrate; do
    migration_attempt=$((migration_attempt + 1))
    if [ "$migration_attempt" -ge 30 ]; then echo "comparison migration did not become ready" >&2; exit 1; fi
    sleep 1
  done

  api_container="${active_project}-api"
  public_url=http://127.0.0.1:8080
  docker run -d --name "$api_container" --platform linux/arm64 --network "${active_project}_default" \
    --cpus 1 --memory 512m --memory-swap 512m --pids-limit 256 --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,size=4g -v "$secrets_dir:/run/eventglass:ro" \
    -e EVENTGLASS_DATABASE_URL="$database_url" \
    -e EVENTGLASS_PUBLIC_URL="$public_url" \
    -e EVENTGLASS_ROLES=api \
    -e EVENTGLASS_HTTP_ADDR=:8080 \
    -e EVENTGLASS_METRICS_ADDR=:9090 \
    -e EVENTGLASS_SCRATCH_DIR=/tmp/eventglass \
    -e EVENTGLASS_S3_ENDPOINT=http://minio:9000 \
    -e EVENTGLASS_S3_REGION=us-east-1 \
    -e EVENTGLASS_S3_BUCKET=eventglass-g00 \
    -e EVENTGLASS_S3_PREFIX="$prefix" \
    -e EVENTGLASS_INSECURE_COOKIE=true \
    -e EVENTGLASS_BOOTSTRAP_TOKEN_FILE=/run/eventglass/bootstrap.hex \
    -e EVENTGLASS_AUTH_HASH_KEY_FILE=/run/eventglass/auth.hex \
    -e EVENTGLASS_TOKEN_KEY_FILE=/run/eventglass/token.hex \
    -e EVENTGLASS_ALERT_ENCRYPTION_KEY_FILE=/run/eventglass/alert.hex \
    -e AWS_ACCESS_KEY_ID=eventglass-local \
    -e AWS_SECRET_ACCESS_KEY=eventglass-local-secret \
    "$runtime_image" run >/dev/null
  app_containers="$api_container"

  docker run --rm --platform linux/arm64 --network "${active_project}_default" \
    -v "$artifacts_dir:/comparison" -v "$comparison_binary:/comparison.test:ro" \
    -e EVENTGLASS_COMPARISON_BASE_URL="http://${api_container}:8080" \
    -e EVENTGLASS_COMPARISON_STATE=/comparison/state.json \
    -e EVENTGLASS_COMPARISON_BOOTSTRAP_TOKEN="$bootstrap_token" \
    --entrypoint /comparison.test "$build_image" \
    -test.count=1 -test.timeout 5m -test.run '^TestPrepareComparisonInstallation$' -test.v

  public_url=https://eventglass.invalid
  scheduler_container="${active_project}-scheduler"
  start_runtime "$scheduler_container" scheduler "$prefix"
  app_containers="$app_containers $scheduler_container"
  worker_metrics=""
  index=1
  while [ "$index" -le "$workers" ]; do
    worker_container="${active_project}-worker-$index"
    start_runtime "$worker_container" worker "$prefix"
    app_containers="$app_containers $worker_container"
    worker_metrics="${worker_metrics},http://${worker_container}:9090"
    index=$((index + 1))
  done
  metrics="http://${api_container}:9090,http://${scheduler_container}:9090${worker_metrics}"

  stats_file="$artifacts_dir/docker-stats.jsonl"
  oom_file="$artifacts_dir/docker-oom.tsv"
  cgroup_file="$artifacts_dir/cgroup-memory.tsv"
  (
    while docker inspect "$api_container" >/dev/null 2>&1; do
      sample=$(date +%s)
      docker stats --no-stream --format "{\"sample\":$sample,\"name\":\"{{.Name}}\",\"mem_usage\":\"{{.MemUsage}}\",\"cpu_percent\":\"{{.CPUPerc}}\",\"net_io\":\"{{.NetIO}}\",\"block_io\":\"{{.BlockIO}}\",\"pids\":\"{{.PIDs}}\"}" $app_containers \
        "${active_project}-postgres-1" "${active_project}-minio-1" >>"$stats_file" 2>/dev/null || true
      sleep 5
    done
  ) &
  stats_pid=$!

  if [ "$mode" = capacity ]; then
    # Same disposable topology/budgets as the sustained runner; only the
    # workload and resource-incarnation policy differ. No runtime test flags.
    . "$ROOT/scripts/comparison-capacity"
    run_capacity_profile
    cleanup_profile
    continue
  fi

  (
    # Keep the process restart inside sustained load without synchronizing it
    # to the five-second interactive-query tick. Expired in-flight query leases
    # are exercised by the dedicated PostgreSQL integration test.
    if [ "${EVENTGLASS_COMPARISON_QUICK:-}" = "1" ]; then sleep 44; else sleep 1204; fi
    victim="${active_project}-worker-1"
    docker run --rm --platform linux/arm64 --network "${active_project}_default" \
      --entrypoint curl "$build_image" -fsS "http://${victim}:9090/metrics" \
      >"$artifacts_dir/restarted-worker.metrics"
    capture_cgroup "$victim"
    docker logs "$victim" >"$artifacts_dir/restarted-worker.log" 2>&1
    docker kill "$victim" >/dev/null
    docker inspect --format '{{.Name}} {{.State.OOMKilled}}' "$victim" >>"$oom_file"
    docker rm "$victim" >/dev/null
    start_runtime "$victim" worker "$prefix"
  ) &
  restart_pid=$!

  set +e
  docker run --rm --platform linux/arm64 --network "${active_project}_default" \
    -v "$artifacts_dir:/comparison" -v "$comparison_binary:/comparison.test:ro" \
    -e EVENTGLASS_DATABASE_URL="$database_url" \
    -e EVENTGLASS_COMPARISON_BASE_URL="http://${api_container}:8080" \
    -e EVENTGLASS_COMPARISON_STATE=/comparison/state.json \
    -e EVENTGLASS_COMPARISON_REPORT="/comparison/report.json" \
    -e EVENTGLASS_COMPARISON_WORKERS="$workers" \
    -e EVENTGLASS_COMPARISON_WARMUP="$warmup" \
    -e EVENTGLASS_COMPARISON_LOAD="$load" \
    -e EVENTGLASS_COMPARISON_DRAIN="$drain" \
    -e EVENTGLASS_COMPARISON_QUICK="${EVENTGLASS_COMPARISON_QUICK:-}" \
    -e EVENTGLASS_COMPARISON_REVISION="$revision" \
    -e EVENTGLASS_COMPARISON_INPUT_EPOCH="$input_epoch" \
    -e EVENTGLASS_COMPARISON_METRICS="$metrics" \
    -e EVENTGLASS_COMPARISON_RESTART_METRICS=/comparison/restarted-worker.metrics \
    --entrypoint /comparison.test "$build_image" \
    -test.count=1 -test.timeout "$test_timeout" -test.run '^TestSustainedComparison$' -test.v
  status=$?
  set -e
  kill "$restart_pid" >/dev/null 2>&1 || true
  wait "$restart_pid" >/dev/null 2>&1 || true
  # Finish independent cold/idle validation even if a load SLO missed. Replace
  # only this disposable project's workers; every cache lives on their tmpfs.
  if [ -f "$artifacts_dir/report.json" ]; then
    postload_ready=1
    index=1
    while [ "$index" -le "$workers" ]; do
      cold_worker="${active_project}-worker-$index"
      old_id=$(docker inspect --format '{{.Id}}' "$cold_worker") || { postload_ready=0; break; }
      capture_cgroup "$cold_worker" || { postload_ready=0; break; }
      docker logs "$cold_worker" >"$artifacts_dir/pre-cold-worker-$index.log" 2>&1 || { postload_ready=0; break; }
      docker stop --time 30 "$cold_worker" >/dev/null || { postload_ready=0; break; }
      docker inspect --format '{{.Name}} {{.State.OOMKilled}}' "$cold_worker" >>"$oom_file" || { postload_ready=0; break; }
      docker rm "$cold_worker" >/dev/null || { postload_ready=0; break; }
      start_runtime "$cold_worker" worker "$prefix" || { postload_ready=0; break; }
      new_id=$(docker inspect --format '{{.Id}}' "$cold_worker") || { postload_ready=0; break; }
      docker exec "$cold_worker" sh -c 'test ! -d /tmp/eventglass/block-cache || test -z "$(find /tmp/eventglass/block-cache -type f -print -quit)"' || { postload_ready=0; break; }
      printf '%s %s %s\n' "$cold_worker" "$old_id" "$new_id" >>"$artifacts_dir/cold-cache-workers.tsv"
      index=$((index + 1))
    done
    if [ "$postload_ready" -eq 1 ]; then
      set +e
      docker run --rm --platform linux/arm64 --network "${active_project}_default" \
        -v "$artifacts_dir:/comparison" -v "$comparison_binary:/comparison.test:ro" \
        -e EVENTGLASS_DATABASE_URL="$database_url" \
        -e EVENTGLASS_COMPARISON_BASE_URL="http://${api_container}:8080" \
        -e EVENTGLASS_COMPARISON_STATE=/comparison/state.json \
        -e EVENTGLASS_COMPARISON_REPORT=/comparison/report.json \
        -e EVENTGLASS_COMPARISON_COLD_WORKERS=/comparison/cold-cache-workers.tsv \
        -e EVENTGLASS_COMPARISON_METRICS="$metrics" \
        -e EVENTGLASS_COMPARISON_QUICK="${EVENTGLASS_COMPARISON_QUICK:-}" \
        --entrypoint /comparison.test "$build_image" \
        -test.count=1 -test.timeout 5m -test.run '^TestPostLoadComparison$' -test.v
      postload_status=$?
      set -e
      if [ "$postload_status" -ne 0 ]; then status=$postload_status; fi
    else
      status=1
    fi
  fi
  kill "$stats_pid" >/dev/null 2>&1 || true
  wait "$stats_pid" >/dev/null 2>&1 || true
  stats_pid=""
  for container in $app_containers "${active_project}-postgres-1" "${active_project}-minio-1"; do
    capture_cgroup "$container" || status=1
    docker inspect --format '{{.Name}} {{.State.OOMKilled}}' "$container" >>"$oom_file" || status=1
  done
  if [ -f "$artifacts_dir/report.json" ]; then
    set +e
    GOCACHE="$ROOT/.tools/go-build-cache" go run ./tests/comparison/report \
      "$artifacts_dir/report.json" "$stats_file" "$oom_file" "$ROOT/tests/comparison/pricing.json" "$cgroup_file"
    report_status=$?
    set -e
    if [ "$status" -eq 0 ] && [ "$report_status" -ne 0 ]; then status=$report_status; fi
    # Keep each run's evidence; the latest-run files below are overwritten.
    evidence_dir=$(mktemp -d "$ROOT/.tools/comparison-report-${workers}.XXXXXX")
    cp "$artifacts_dir/report.json" "$evidence_dir/report.json"
    cp "$stats_file" "$evidence_dir/docker-stats.jsonl"
    cp "$oom_file" "$evidence_dir/docker-oom.tsv"
    if [ -f "$cgroup_file" ]; then cp "$cgroup_file" "$evidence_dir/cgroup-memory.tsv"; fi
    if [ -f "$artifacts_dir/restarted-worker.log" ]; then
      cp "$artifacts_dir/restarted-worker.log" "$evidence_dir/restarted-worker.log"
    fi
    if [ -f "$artifacts_dir/cold-cache-workers.tsv" ]; then
      cp "$artifacts_dir/cold-cache-workers.tsv" "$evidence_dir/cold-cache-workers.tsv"
    fi
    for phase_log in "$artifacts_dir"/pre-cold-worker-*.log; do
      if [ -f "$phase_log" ]; then cp "$phase_log" "$evidence_dir/"; fi
    done
    for container in $app_containers; do
      docker logs "$container" >"$evidence_dir/$container.log" 2>&1 || true
    done
    echo "R3 retained evidence: $evidence_dir"
  fi
  if [ "$status" -ne 0 ]; then
    if [ -f "$artifacts_dir/report.json" ]; then
      cp "$artifacts_dir/report.json" "$ROOT/.tools/comparison-workers-$workers-failed.json"
      cp "$stats_file" "$ROOT/.tools/comparison-workers-$workers-failed-stats.jsonl"
      echo "R3 failed evidence: $ROOT/.tools/comparison-workers-$workers-failed.json" >&2
    fi
    for container in $app_containers; do docker logs "$container" >&2 || true; done
    profile_failures=1
    cleanup_profile
    continue
  fi
  cp "$artifacts_dir/report.json" "$ROOT/.tools/comparison-workers-$workers.json"
  cp "$stats_file" "$ROOT/.tools/comparison-workers-$workers-stats.jsonl"
  echo "R3 comparison evidence: $ROOT/.tools/comparison-workers-$workers.json"
  cleanup_profile
done

if [ "$mode" = capacity ]; then
  matrix=$(mktemp "$ROOT/.tools/capacity-matrix.XXXXXX")
  "$run_dir/capacity-report" capacity-matrix "$run_dir/capacity-reports.txt" "$matrix"
  echo "Capacity matrix: $matrix"
fi

GOCACHE="$ROOT/.tools/go-build-cache" GOMODCACHE="$ROOT/.tools/go-mod-cache" \
  go test -count=1 -run '^TestFixedDatasetProfilesMatchIndependentOracle$' -v ./tests/comparison
if [ "$profile_failures" -ne 0 ]; then exit 1; fi
