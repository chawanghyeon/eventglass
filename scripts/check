#!/bin/sh
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

if [ -x "$ROOT/.tools/go1.26.5/bin/go" ]; then
  PATH="$ROOT/.tools/go1.26.5/bin:$PATH"
  export PATH
fi

GOCACHE=${GOCACHE:-"$ROOT/.tools/go-build-cache"}
GOMODCACHE=${GOMODCACHE:-"$ROOT/.tools/go-mod-cache"}
export GOCACHE GOMODCACHE
mkdir -p "$GOCACHE" "$GOMODCACHE"

check_go_version() {
  expected=$(awk '/^go / { print $2; exit }' go.mod)
  actual=$(go env GOVERSION | sed 's/^go//')
  if [ "$actual" != "$expected" ]; then
    echo "Go $expected is required; found $actual" >&2
    exit 1
  fi
}

unit() {
  check_go_version
  go test ./tests/architecture ./internal/alerts ./internal/api ./internal/app ./internal/control ./internal/ingest ./internal/issues ./internal/model ./internal/query ./internal/resource ./internal/sdk ./internal/storage ./cmd/eventglass-go
  go vet ./internal/alerts ./internal/api ./internal/app ./internal/control ./internal/ingest ./internal/issues ./internal/model ./internal/query ./internal/resource ./internal/sdk ./internal/storage ./cmd/eventglass-go
  python3 -m unittest deploy/test_layout.py
  test "$(sha256sum docs/observe/source-design.md | awk '{print $1}')" = "4cccddc98f76d5c38099958587386c55756a08cf366c26ed9e65eeedec0526e5"
}

codegen() {
  check_go_version
  if [ ! -x "$ROOT/tools/codegen/node_modules/.bin/openapi-typescript" ]; then
    echo "missing codegen dependencies; run npm ci --prefix tools/codegen --ignore-scripts" >&2
    exit 1
  fi
  generated_dir=$(mktemp -d "$ROOT/.tools/eventglass-codegen.XXXXXX")
  cleanup_codegen() {
    rm -rf "$generated_dir"
  }
  trap cleanup_codegen EXIT INT TERM
  go tool oapi-codegen -generate types -package generated -o "$generated_dir/types.gen.go" api/openapi.yaml
  npm exec --prefix tools/codegen -- openapi-typescript "$ROOT/api/openapi.yaml" -o "$generated_dir/api.ts" >/dev/null
  cmp api/generated/types.gen.go "$generated_dir/types.gen.go"
  cmp web/src/generated/api.ts "$generated_dir/api.ts"
}

contracts() {
  docker_required contracts
  case "$(uname -m)" in
    arm64|aarch64) platform=linux/arm64 ;;
    *) echo "unsupported contract-test architecture: $(uname -m)" >&2; exit 1 ;;
  esac
  docker buildx build --platform "$platform" --target test --load --tag eventglass-go:g00-test .
}

docker_required() {
  if ! docker info >/dev/null 2>&1; then
    echo "Docker is required for $1; the daemon is unavailable" >&2
    exit 1
  fi
}

integration() {
  docker_required integration
  project="eventglass-go-integration-$$"
  cleanup() {
    docker compose -p "$project" -f deploy/compose.yaml down --volumes --remove-orphans >/dev/null 2>&1 || true
  }
  trap cleanup EXIT INT TERM
  docker compose -p "$project" -f deploy/compose.yaml up -d postgres minio
  docker compose -p "$project" -f deploy/compose.yaml run --rm minio-init
  postgres_address=$(docker compose -p "$project" -f deploy/compose.yaml port postgres 5432 | tail -n 1)
  minio_address=$(docker compose -p "$project" -f deploy/compose.yaml port minio 9000 | tail -n 1)
  EVENTGLASS_INTEGRATION_REQUIRED=1 \
    EVENTGLASS_DATABASE_URL="postgres://eventglass:local-test-only@${postgres_address}/eventglass?sslmode=disable" \
    EVENTGLASS_S3_ENDPOINT="http://${minio_address}" \
    EVENTGLASS_S3_BUCKET=eventglass-g00 \
    AWS_ACCESS_KEY_ID=eventglass-local \
    AWS_SECRET_ACCESS_KEY=eventglass-local-secret \
    go test -count=1 ./tests/integration
  docker buildx build --platform linux/arm64 --target build --load --tag eventglass-go:integration-build .
  docker run --rm --platform linux/arm64 --network "${project}_default" \
    -e EVENTGLASS_INTEGRATION_REQUIRED=1 \
    -e EVENTGLASS_DATABASE_URL="postgres://eventglass:local-test-only@postgres:5432/eventglass?sslmode=disable" \
    -e EVENTGLASS_S3_ENDPOINT=http://minio:9000 \
    -e EVENTGLASS_S3_BUCKET=eventglass-g00 \
    -e EVENTGLASS_TEST_BINARY=/out/eventglass-go \
    -e AWS_ACCESS_KEY_ID=eventglass-local \
    -e AWS_SECRET_ACCESS_KEY=eventglass-local-secret \
    -w /src eventglass-go:integration-build \
    go test -tags=duckdb_use_static_lib -count=1 -run '^TestPublicQueryEndToEnd' -v ./tests/integration
}

crash() {
  check_go_version
  docker_required crash
  case "$(uname -m)" in
    arm64|aarch64) ;;
    *) echo "unsupported crash-test architecture: $(uname -m)" >&2; exit 1 ;;
  esac
  project="eventglass-go-crash-$$"
  artifact_dir=$(mktemp -d "$ROOT/.tools/eventglass-crash.XXXXXX")
  cleanup() {
    docker compose -p "$project" -f deploy/compose.yaml down --volumes --remove-orphans >/dev/null 2>&1 || true
    rm -rf "$artifact_dir"
  }
  trap cleanup EXIT INT TERM
  docker compose -p "$project" -f deploy/compose.yaml up -d postgres minio
  docker compose -p "$project" -f deploy/compose.yaml run --rm minio-init
  docker buildx build --platform linux/arm64 --target build --load --tag eventglass-go:crash-build .
  docker run --rm --platform linux/arm64 -v "$artifact_dir:/eventglass-tests" eventglass-go:crash-build \
    go test -tags=duckdb_use_static_lib -c -o /eventglass-tests/crash.test ./tests/crash
  docker run --rm --platform linux/arm64 -v "$artifact_dir:/eventglass-tests" eventglass-go:crash-build \
    go test -tags=duckdb_use_static_lib -c -o /eventglass-tests/ingest-resource.test ./tests/resource
  runner_image="eventglass-go:crash-build"
  docker run --rm --platform linux/arm64 --network "${project}_default" \
    --cpus 1 --memory 512m --memory-swap 512m --pids-limit 256 \
    -e EVENTGLASS_CRASH_REQUIRED=1 \
    -e EVENTGLASS_DATABASE_URL="postgres://eventglass:local-test-only@postgres:5432/eventglass?sslmode=disable" \
    -e EVENTGLASS_S3_ENDPOINT=http://minio:9000 \
    -e EVENTGLASS_S3_BUCKET=eventglass-g00 \
    -e EVENTGLASS_TEST_S3_PREFIX="crash-$project" \
    -e AWS_ACCESS_KEY_ID=eventglass-local \
    -e AWS_SECRET_ACCESS_KEY=eventglass-local-secret \
    -v "$artifact_dir:/eventglass-tests:ro" \
    --entrypoint /eventglass-tests/crash.test "$runner_image" -test.v -test.count=1
  docker run --rm --platform linux/arm64 \
    --cpus 1 --memory 512m --memory-swap 512m --pids-limit 256 \
    -v "$artifact_dir:/eventglass-tests:ro" \
    --entrypoint /eventglass-tests/ingest-resource.test "$runner_image" -test.v -test.count=1
}

sdk() {
  check_go_version
  python3 tools/sdk-fixtures/verify.py
  for dependency in \
    tools/sdk-fixtures/.venv/bin/python \
    tools/sdk-fixtures/go-app/eventglass-go-fixture \
    tools/sdk-fixtures/browser-app/dist/app.js
  do
    if [ ! -e "$dependency" ]; then
      echo "missing SDK fixture dependency: $dependency; run tools/sdk-fixtures/bootstrap.sh" >&2
      exit 1
    fi
  done
  EVENTGLASS_SDK_LIVE=1 go test -count=1 \
    ./internal/sdk ./internal/ingest ./internal/api ./tests/sdk
}

web() {
  expected_node=$(node -p "require('./web/package.json').engines.node")
  actual_node=$(node -p "process.versions.node")
  if [ "$actual_node" != "$expected_node" ]; then
    echo "Node $expected_node is required for web checks; found $actual_node" >&2
    exit 1
  fi
  if [ ! -d web/node_modules ]; then
    echo "missing web dependencies; run npm ci --prefix web --ignore-scripts" >&2
    exit 1
  fi
  npm test --prefix web
  npm run build --prefix web
}

missing() {
  echo "$1 is unavailable until its implementation gate is complete" >&2
  exit 1
}

case "${1:-}" in
  architecture) check_go_version; go test -count=1 ./tests/architecture ;;
  focused)
    check_go_version
    shift
    case "${1:-}" in
      api|app|control|ingest|issues|model|query|resource|sdk|storage)
        package=$1
        shift
        go test "./internal/$package" "$@"
        ;;
      *) echo "focused requires api|app|control|ingest|issues|model|query|resource|sdk|storage" >&2; exit 2 ;;
    esac
    ;;
  journal-bench) check_go_version; go test ./internal/storage -run '^$' -bench BenchmarkJournal -benchmem -count=1 ;;
  unit) unit ;;
  codegen) codegen ;;
  contracts) contracts ;;
  integration) integration ;;
  sdk) sdk ;;
  crash) crash ;;
  web) web ;;
  resource) docker_required resource; missing "resource verification" ;;
  scale) docker_required scale; missing "scale verification" ;;
  comparison) docker_required comparison; missing "comparison verification" ;;
  release) docker_required release; missing "release verification" ;;
  *) echo "usage: ./scripts/check {unit|codegen|architecture|focused PACKAGE|journal-bench|contracts|integration|sdk|crash|web|resource|scale|comparison|release}" >&2; exit 2 ;;
esac
