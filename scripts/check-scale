#!/bin/sh
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
case "$(uname -m)" in
  arm64|aarch64) ;;
  *) echo "unsupported scale-test architecture: $(uname -m)" >&2; exit 1 ;;
esac

./scripts/build-image --target build --load --tag eventglass-go:scale-build
docker run --rm --platform linux/arm64 -v "$ROOT:/src:ro" -w /src eventglass-go:scale-build \
  go test -count=1 -v ./internal/app ./tests/scale
